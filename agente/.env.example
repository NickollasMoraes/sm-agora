# Copie este arquivo para ".env" e preencha. Nunca envie o .env para o GitHub.

# Como o agente usa o Claude:
#   claude-code = pelo seu plano do Claude (sem custo extra). Antes, rode uma vez: claude auth login
#   api         = pela API paga da Anthropic (preencha ANTHROPIC_API_KEY)
IA_PROVEDOR=claude-code
# Triagem das notícias: local = por palavras-chave (grátis) | ia = a IA avalia cada item
TRIAGEM=local
# Modelo no Claude Code (vazio = padrão do seu plano). Ex.: opus, sonnet
MODELO_CLAUDE_CODE=

# Só se IA_PROVEDOR=api. Chave em https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Bot do Telegram: fale com @BotFather, envie /newbot e cole o token aqui
TELEGRAM_BOT_TOKEN=
# Deixe vazio, rode o agente, mande /start para o bot e ele responde o número
TELEGRAM_CHAT_ID=

# Dados do site
SITE_URL=https://smagora.com.br
SITE_NOME=SM Agora
INSTAGRAM_ARROBA=smagora

# Coleta: a cada 30 min das 6h às 23h (formato cron)
CRON_COLETA=*/30 6-23 * * *
NOTA_MINIMA=7
MAX_PAUTAS_POR_RODADA=8

# Só se IA_PROVEDOR=api: modelo que escreve as matérias
MODELO_IA=claude-opus-5-5
# Modelo só da triagem (roda a cada 30 min). Vazio = mesmo do MODELO_IA. Mais barato: claude-haiku-5-5
MODELO_TRIAGEM=

# Opcional: mais opções de fotos livres (grátis): https://www.pexels.com/api/
PEXELS_API_KEY=

# Opcional: postagem automática no Instagram (veja o GUIA). Sem isso, o bot manda a arte para você postar.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# true = envia cada notícia para o GitHub (o site atualiza sozinho)
GIT_PUSH=true
